# Server variables only. Copy to .env.local; never commit real credentials.
FIREBASE_PROJECT_ID=desha-news
FIREBASE_WEB_API_KEY=
FIREBASE_SERVICE_ACCOUNT_PATH=.secrets/firebase-service-account.json
# Hosted runtime: use these instead of a local JSON file.
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_ADMIN_UIDS=
ADMIN_EMAILS=
AUTH_PROVIDER=firebase
CONTENT_PROVIDER=firebase
MEDIA_PROVIDER=cloudinary
CLOUDINARY_CLOUD_NAME=rna4y0mn
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Set only when the site is publicly hosted and ready for indexing.
PUBLIC_SITE=false
SITE_URL=
# Real publisher ID only; leaving blank returns 404 for ads.txt.
ADSENSE_PUBLISHER_ID=
# Optional: Set this to automatically inject Google AdSense script in Next.js (e.g. ca-pub-XXXXXXXXXXXXXXXX)
NEXT_PUBLIC_ADSENSE_CLIENT_ID=
